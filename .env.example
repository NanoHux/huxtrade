NODE_ENV=development
TZ=Asia/Shanghai
DATABASE_URL=postgres://huxtrade:huxtrade@postgres:5432/huxtrade
POSTGRES_DB=huxtrade
POSTGRES_USER=huxtrade
POSTGRES_PASSWORD=huxtrade
API_HOST=0.0.0.0
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://api:4000
WEB_ORIGIN=http://localhost:3000

# Market data
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
# The CoinGlass free web Heatmap encrypts its response and rotates the cipher
# without notice, so the agent drives a real logged-in browser instead of
# reimplementing the encryption: it lets CoinGlass's own page JS decrypt the
# data and reads the result back out. No API key or Cookie is stored here.
COINGLASS_ADAPTER_MODE=disabled
COINGLASS_PROFILE_PATH=./coinglass-profile
COINGLASS_BROWSER_EXECUTABLE=
# Optional: attach to an operator-launched dedicated Chrome on loopback.
# COINGLASS_CDP_URL=http://127.0.0.1:9223
COINGLASS_CDP_URL=
COINGLASS_AGENT_POLL_MS=15000
COINGLASS_REFRESH_MS=600000

# Variational browser-context adapter. Keep live trading false until the
# dedicated browser profile is logged in and read-only reconciliation passes.
VARIATIONAL_BASE_URL=https://omni.variational.io/perpetual/BTC
VARIATIONAL_PROFILE_PATH=./playwright-profile
VARIATIONAL_BROWSER_EXECUTABLE=
# Optional: attach to an operator-launched dedicated Chrome on loopback.
# VARIATIONAL_CDP_URL=http://127.0.0.1:9222
VARIATIONAL_CDP_URL=
VARIATIONAL_DISCOVERY_OUTPUT=./variational-discovery
VARIATIONAL_DISCOVERY_ALLOWED_ORIGINS=
VARIATIONAL_ADAPTER_MODE=disabled
VARIATIONAL_ENTRY_SLIPPAGE=0.005
VARIATIONAL_PROTECTION_SLIPPAGE=0.03
VARIATIONAL_CLOSE_SLIPPAGE=0.01
LIVE_TRADING_ENABLED=false
# Resting limit entry model. `shadow` computes every decision and writes the
# full entry_plans ledger but puts nothing on the wire — this is the default
# and the rollback position. Switch to `live` only after the shadow ledger has
# been compared against the running strategy (spec 8).
STRATEGY_EXECUTION_MODE=shadow

# One Telegram destination, per V1 scope.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Fixed product rules
DEFAULT_MARGIN_USDC=10
MAX_MARGIN_USDC=20
LEVERAGE=5
MAX_ORDERS_PER_SYMBOL_SIDE=5
MARGIN_PAUSE_PERCENT=80
MARGIN_RESUME_PERCENT=75
