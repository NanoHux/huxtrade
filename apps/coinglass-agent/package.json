{
  "name": "@huxtrade/coinglass-agent",
  "private": true,
  "type": "module",
  "dependencies": {
    "@huxtrade/config": "workspace:*",
    "@huxtrade/database": "workspace:*",
    "@huxtrade/exchange-clients": "workspace:*",
    "playwright-core": "^1.54.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
