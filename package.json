{
  "name": "huxtrade",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @huxtrade/api --filter @huxtrade/web dev",
    "db:migrate": "pnpm --filter @huxtrade/database migrate",
    "db:seed": "pnpm --filter @huxtrade/database seed",
    "coinglass:agent": "pnpm --filter @huxtrade/coinglass-agent start",
    "macos:variational:install": "node scripts/macos/variational-launchagent.mjs install",
    "macos:variational:status": "node scripts/macos/variational-launchagent.mjs status",
    "macos:variational:uninstall": "node scripts/macos/variational-launchagent.mjs uninstall",
    "macos:coinglass:install": "node scripts/macos/coinglass-launchagent.mjs install",
    "macos:coinglass:status": "node scripts/macos/coinglass-launchagent.mjs status",
    "macos:coinglass:uninstall": "node scripts/macos/coinglass-launchagent.mjs uninstall",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
