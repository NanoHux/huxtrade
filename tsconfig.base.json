{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@huxtrade/shared-types": ["packages/shared-types/src/index.ts"],
      "@huxtrade/config": ["packages/config/src/index.ts"],
      "@huxtrade/database": ["packages/database/src/index.ts"],
      "@huxtrade/indicators": ["packages/indicators/src/index.ts"],
      "@huxtrade/strategy-engine": ["packages/strategy-engine/src/index.ts"],
      "@huxtrade/exchange-clients": ["packages/exchange-clients/src/index.ts"]
    }
  }
}

